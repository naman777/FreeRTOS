{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP-IDF: Build",
            "type": "shell",
            "command": "idf.py build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "ESP-IDF: Clean",
            "type": "shell",
            "command": "idf.py fullclean",
            "group": "build"
        },
        {
            "label": "ESP-IDF: Set Target ESP32",
            "type": "shell",
            "command": "idf.py set-target esp32",
            "group": "build"
        }
    ]
}
